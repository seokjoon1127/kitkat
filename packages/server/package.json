{
  "name": "@kitkat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/websocket": "^11.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@kitkat/schema": "*",
    "@kitkat/engine": "*",
    "@kitkat/media": "*",
    "@kitkat/renderer": "*",
    "@kitkat/ai": "*",
    "execa": "^9.5.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0"
  }
}
